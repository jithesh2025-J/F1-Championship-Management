# Copy this file to .env and fill in values for your local Oracle 26ai Free install.
# Never commit .env.

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# Easy Connect descriptor. Listener on this machine advertises:
#   FREE        (container database)
#   FREEPDB1    (pluggable database — use this for application objects)
ORACLE_USER=f1_champ
ORACLE_PASSWORD=change_me
ORACLE_DSN=localhost:1521/FREEPDB1

# Optional: thick mode (only if you must use Instant Client)
ORACLE_THICK_MODE=false

F1_VIEWER_USER=f1_viewer
F1_VIEWER_PASSWORD=change_me

# Security: Enable interactive SQL console and trigger demo (set to true ONLY for local dev, false in prod)
ENABLE_DEV_CONSOLE=false

# Security: Server-side admin key for write operations (POST, PUT, DELETE)
ADMIN_API_KEY=change_me
